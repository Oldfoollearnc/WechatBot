<Window x:Class="WechatBot.AppMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="排序小助手"
        Height="720" Width="1060"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="#FF202020">

    <Window.Resources>
        <!-- 导航项样式 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF999999"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3D3D40"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF00CC6A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边导航栏 -->
        <Border Grid.Column="0" Background="#FF2D2D30" Width="200">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Background="#FF252528" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="🐷" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="排序小助手" FontSize="14" FontWeight="Bold"
                                   Foreground="#FFEEEEEE" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="猪猪工作室" FontSize="10" Foreground="#FF666666"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底部版本 -->
                <Border DockPanel.Dock="Bottom" Padding="0,0,0,16">
                    <TextBlock Text="v1.0.0" FontSize="10" Foreground="#FF444448"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- 导航项 -->
                <StackPanel Margin="0,8,0,0">
                    <RadioButton x:Name="NavHome" Content="  🏠  首页" IsChecked="True"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSteps" Content="  📋  步骤"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLogs" Content="  📜  日志"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="  ⚙  设置"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部状态条 -->
            <Border Grid.Row="0" Background="#FF2D2D30" Padding="20,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="15" Foreground="#FFCCCCCC"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="已配置" Foreground="#FF888888" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ConfiguredCount}" Foreground="#FF00CC6A" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="/" Foreground="#FF666666" FontSize="14" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="{Binding TotalCount}" Foreground="#FF888888" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 页面内容 -->
            <ContentControl Grid.Row="1" x:Name="PageContent"/>

            <!-- 底部版权 -->
            <Border Grid.Row="2" Background="#FF252528" Padding="20,8">
                <TextBlock HorizontalAlignment="Center" FontSize="11">
                    <Run Text="猪猪工作室" Foreground="#FFCC8899"/>
                    <Run Text=" | 图像识别自动化工具" Foreground="#FF666666"/>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
