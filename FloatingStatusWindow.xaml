<Window x:Class="WechatBot.FloatingStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="280" Height="80"
        ResizeMode="NoResize">

    <Border Background="#F02A2A2E" CornerRadius="12" Padding="16,12"
            BorderBrush="#44FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 状态图标 -->
            <TextBlock x:Name="StatusIcon" Grid.Column="0" Text="⏸" FontSize="28"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- 状态信息 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="等待中" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFEEEEEE"/>
                <TextBlock x:Name="StepInfo" Text="" FontSize="11" Foreground="#FF888888"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
