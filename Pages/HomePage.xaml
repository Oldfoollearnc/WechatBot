<UserControl x:Class="WechatBot.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="#FF202020">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>

            <!-- 标题 -->
            <TextBlock Text="仪表盘" FontSize="24" FontWeight="Bold" Foreground="#FFEEEEEE" Margin="0,0,0,20"/>

            <!-- 三列指标卡片 -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 总步骤 -->
                <Border Grid.Column="0" Background="#FF2D2D30" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="总步骤" FontSize="12" Foreground="#FF888888" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="32" FontWeight="Bold" Foreground="#FFEEEEEE"/>
                        <TextBlock Text="个自动化步骤" FontSize="11" Foreground="#FF666666" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 已配置 -->
                <Border Grid.Column="2" Background="#FF2D2D30" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="已配置" FontSize="12" Foreground="#FF888888" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ConfiguredCount}" FontSize="32" FontWeight="Bold" Foreground="#FF00CC6A"/>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4"
                                     Background="#FF3D3D40" Foreground="#FF00CC6A" BorderThickness="0"
                                     Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 状态 -->
                <Border Grid.Column="4" Background="#FF2D2D30" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="状态" FontSize="12" Foreground="#FF888888" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusIcon}" FontSize="28" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#FFCCCCCC"/>
                        <TextBlock FontSize="11" Foreground="#FF666666" Margin="0,4,0,0">
                            <Run Text="上次运行："/>
                            <Run Text="{Binding LastRunTime}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 快捷操作 -->
            <TextBlock Text="快捷操作" FontSize="16" FontWeight="SemiBold" Foreground="#FFEEEEEE" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FF1A3A2A" CornerRadius="8" Padding="20,16"
                        Cursor="Hand" MouseLeftButtonDown="Run_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="开始运行" FontSize="14" FontWeight="SemiBold" Foreground="#FF00CC6A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="执行全部14步" FontSize="11" Foreground="#FF666666"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FF1A2A3A" CornerRadius="8" Padding="20,16"
                        Cursor="Hand" MouseLeftButtonDown="Test_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🧪" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="测试运行" FontSize="14" FontWeight="SemiBold" Foreground="#FF4488CC"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="最小化窗口后执行" FontSize="11" Foreground="#FF666666"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#FF3A2A1A" CornerRadius="8" Padding="20,16"
                        Cursor="Hand" MouseLeftButtonDown="Stop_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏹" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="停止" FontSize="14" FontWeight="SemiBold" Foreground="#FFCC6644"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="中断当前任务" FontSize="11" Foreground="#FF666666"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近日志 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="最近日志" FontSize="16" FontWeight="SemiBold"
                           Foreground="#FFEEEEEE" Margin="0,0,0,12"/>
                <TextBlock Grid.Column="1" Text="查看全部 →" FontSize="12" Foreground="#FF4488CC"
                           Cursor="Hand" VerticalAlignment="Center" Margin="0,0,0,12"/>
            </Grid>

            <Border Background="#FF1E1E22" CornerRadius="8" Padding="16,12" MaxHeight="240">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11"
                                               FontFamily="Consolas" Foreground="#FF666666"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="11"
                                               Foreground="{Binding LevelColor}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11"
                                               Foreground="#FFAAAAAA" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
