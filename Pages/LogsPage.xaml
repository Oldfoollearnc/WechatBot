<UserControl x:Class="WechatBot.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:WechatBot.ViewModels"
             Background="#FF202020">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="运行日志" FontSize="24" FontWeight="Bold"
                   Foreground="#FFEEEEEE" Margin="0,0,0,16"/>

        <!-- 筛选栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButton Grid.Column="0" Content="全部" IsChecked="True" Foreground="#FFCCCCCC"
                         Margin="0,0,16,0" Click="Filter_Click" Tag="All"/>
            <RadioButton Grid.Column="1" Content="INFO" Foreground="#FF00CC6A"
                         Margin="0,0,16,0" Click="Filter_Click" Tag="Info"/>
            <RadioButton Grid.Column="2" Content="WARN" Foreground="#FFCCAA00"
                         Margin="0,0,16,0" Click="Filter_Click" Tag="Warn"/>
            <RadioButton Grid.Column="3" Content="ERROR" Foreground="#FFCC4444"
                         Margin="0,0,16,0" Click="Filter_Click" Tag="Error"/>

            <TextBox Grid.Column="5" x:Name="SearchBox" Width="200" VerticalAlignment="Center"
                     FontSize="12" Padding="8,4" TextChanged="SearchBox_TextChanged"
                     Foreground="#FFCCCCCC" Background="#FF3D3D40" BorderBrush="#FF555558"
                     Tag="搜索日志..."/>
        </Grid>

        <!-- 日志列表 -->
        <Border Grid.Row="2" Background="#FF1E1E22" CornerRadius="8" Padding="12,8">
            <ListBox x:Name="LogListBox" ItemsSource="{Binding Logs}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LogEntry">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11.5"
                                       FontFamily="Consolas" Foreground="#FF555558" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="12"
                                       Foreground="{Binding LevelColor}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11.5"
                                       Foreground="#FFAAAAAA" TextWrapping="Wrap"
                                       FontFamily="Consolas"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="清空日志" Style="{StaticResource ButtonInfo}" Margin="0,0,8,0"
                    Click="Clear_Click"/>
            <Button Content="打开日志目录" Style="{StaticResource ButtonInfo}"
                    Click="OpenLogDir_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
