<UserControl x:Class="WechatBot.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="#FF202020">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="600">

            <!-- 标题 -->
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="#FFEEEEEE" Margin="0,0,0,20"/>

            <!-- 延时设置 -->
            <Border Background="#FF2D2D30" CornerRadius="8" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="⏱ 延时设置" FontSize="14" FontWeight="SemiBold" Foreground="#FFEEEEEE"
                               Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="每步等待" FontSize="12" Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="StepDelaySlider" Minimum="0.5" Maximum="5"
                                Value="{Binding StepDelay}" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#FF4488CC"
                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Run Text="{Binding StepDelay, StringFormat=0.0}"/>
                            <Run Text="s"/>
                        </TextBlock>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="加载等待" FontSize="12" Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="LoadDelaySlider" Minimum="1" Maximum="15"
                                Value="{Binding LoadDelay}" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#FF4488CC"
                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Run Text="{Binding LoadDelay, StringFormat=0}"/>
                            <Run Text="s"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 重试设置 -->
            <Border Background="#FF2D2D30" CornerRadius="8" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🔄 重试设置" FontSize="14" FontWeight="SemiBold" Foreground="#FFEEEEEE"
                               Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最大重试" FontSize="12" Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"/>
                        <hc:NumericUpDown Grid.Column="1" Value="{Binding MaxRetry}" Minimum="1" Maximum="10"
                                          Width="120" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="重试间隔" FontSize="12" Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"/>
                        <hc:NumericUpDown Grid.Column="1" Value="{Binding RetryWait}" Minimum="0.5" Maximum="10"
                                          Increment="0.5" Width="120" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 识别设置 -->
            <Border Background="#FF2D2D30" CornerRadius="8" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🎯 识别设置" FontSize="14" FontWeight="SemiBold" Foreground="#FFEEEEEE"
                               Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="匹配阈值" FontSize="12" Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0.5" Maximum="0.99" Value="{Binding MatchThreshold}"
                                TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#FF4488CC"
                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Run Text="{Binding MatchThreshold, StringFormat=0.00}"/>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="阈值越高匹配越严格，建议 0.75 ~ 0.85" FontSize="11"
                               Foreground="#FF555558" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 定时设置 -->
            <Border Background="#FF2D2D30" CornerRadius="8" Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⏰ 定时执行" FontSize="14" FontWeight="SemiBold" Foreground="#FFEEEEEE"
                               Margin="0,0,0,14"/>

                    <CheckBox Content="启用定时执行" IsChecked="{Binding ScheduleEnabled}"
                              Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="执行时间" FontSize="12" Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"/>
                        <hc:NumericUpDown Grid.Column="1" Value="{Binding ScheduleHour}" Minimum="0" Maximum="23"
                                          Width="80"/>
                        <TextBlock Grid.Column="2" Text=" : " FontSize="16" Foreground="#FFCCCCCC"
                                   VerticalAlignment="Center" Margin="6,0"/>
                        <hc:NumericUpDown Grid.Column="3" Value="{Binding ScheduleMinute}" Minimum="0" Maximum="59"
                                          Width="80"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="执行日期" FontSize="12" Foreground="#FFAAAAAA"
                                   VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <WrapPanel Grid.Column="1">
                            <CheckBox Content="周一" IsChecked="{Binding ScheduleDays[0]}" Foreground="#FFCCCCCC"
                                      Margin="0,0,14,0"/>
                            <CheckBox Content="周二" IsChecked="{Binding ScheduleDays[1]}" Foreground="#FFCCCCCC"
                                      Margin="0,0,14,0"/>
                            <CheckBox Content="周三" IsChecked="{Binding ScheduleDays[2]}" Foreground="#FFCCCCCC"
                                      Margin="0,0,14,0"/>
                            <CheckBox Content="周四" IsChecked="{Binding ScheduleDays[3]}" Foreground="#FFCCCCCC"
                                      Margin="0,0,14,0"/>
                            <CheckBox Content="周五" IsChecked="{Binding ScheduleDays[4]}" Foreground="#FFCCCCCC"
                                      Margin="0,0,14,0"/>
                            <CheckBox Content="周六" IsChecked="{Binding ScheduleDays[5]}" Foreground="#FFCCCCCC"
                                      Margin="0,0,14,0"/>
                            <CheckBox Content="周日" IsChecked="{Binding ScheduleDays[6]}" Foreground="#FFCCCCCC"/>
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 保存按钮 -->
            <Button Content="💾 保存设置" Style="{StaticResource ButtonSuccess}" FontSize="14"
                    Padding="28,10" HorizontalAlignment="Center"
                    Click="Save_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
