<UserControl x:Class="WechatBot.Pages.StepsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:WechatBot.ViewModels"
             Background="#FF202020">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>

            <!-- 标题 -->
            <Grid Margin="0,0,0,20">
                <TextBlock Text="步骤管理" FontSize="24" FontWeight="Bold" Foreground="#FFEEEEEE"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="已配置 " FontSize="13" Foreground="#FF888888" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConfiguredCount}" FontSize="16" FontWeight="Bold"
                               Foreground="#FF00CC6A" VerticalAlignment="Center"/>
                    <TextBlock Text="/" FontSize="13" Foreground="#FF666666" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="13" Foreground="#FF888888"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 步骤列表 -->
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:StepViewModel">
                        <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,8"
                                Background="#FF2D2D30">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 序号圆圈 -->
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                        Background="#FF3D3D40" Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IndexText}" FontSize="13" FontWeight="Bold"
                                               Foreground="#FFCCCCCC" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 名称 + 描述 + 状态 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#FFEEEEEE"/>
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="13" Margin="10,0,4,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                   Foreground="#FF888888" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#FF666666"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="截取" Style="{StaticResource ButtonInfo}" Margin="0,0,6,0"
                                            Tag="{Binding}" Click="Capture_Click"/>
                                    <Button Content="识别" Style="{StaticResource ButtonInfo}" Margin="0,0,6,0"
                                            Tag="{Binding}" Click="TestRecognition_Click"/>
                                    <Button Content="重置" Style="{StaticResource ButtonDanger}"
                                            Tag="{Binding}" Click="Reset_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
