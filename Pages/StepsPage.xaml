<UserControl x:Class="WechatBot.Pages.StepsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:WechatBot.ViewModels"
             Background="{DynamicResource BgBrush}"
             Loaded="StepsPage_Loaded">

    <UserControl.Resources>
        <!-- 截取按钮 -->
        <Style x:Key="CaptureBtn" TargetType="Button">
            <Setter Property="Content" Value="截取"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF2D6A4F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A8A6A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF245A42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 识别按钮 -->
        <Style x:Key="TestBtn" TargetType="Button">
            <Setter Property="Content" Value="识别"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF2A4A6A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A6A8A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1A3A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重置按钮 -->
        <Style x:Key="ResetBtn" TargetType="Button">
            <Setter Property="Content" Value="重置"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DangerDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5A3333"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel>

            <!-- 标题区 -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="步骤管理" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="配置和管理自动化步骤" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已配置 " FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConfiguredCount}" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="/" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 步骤列表 -->
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:StepViewModel">
                        <Border Margin="0,0,0,10" Style="{StaticResource StepCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 序号圆圈 -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                        Margin="0,0,16,0" VerticalAlignment="Center"
                                        Background="{DynamicResource InputBgBrush}">
                                    <TextBlock Text="{Binding IndexText, Mode=OneWay}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 名称 + 描述 + 状态 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Margin="10,0,4,0" CornerRadius="8" Padding="8,3"
                                                VerticalAlignment="Center" Background="{DynamicResource TagInfoBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusIcon, Mode=OneWay}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CaptureBtn}" Margin="0,0,8,0"
                                            Tag="{Binding}" Click="Capture_Click"/>
                                    <Button Style="{StaticResource TestBtn}" Margin="0,0,8,0"
                                            Tag="{Binding}" Click="TestRecognition_Click"/>
                                    <Button Style="{StaticResource ResetBtn}"
                                            Tag="{Binding}" Click="Reset_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
